#pragma once

// Generated by CMake — do not edit manually.
//
// jce_config_files() resolves core + appended files after parameter initialization.
// jce_config_path() is retained as the legacy single-file API for external users.

#include <JANA/JLogger.h>
#include <JANA/JException.h>
#include <iostream>
#include <sstream>
#include <vector>
#include <unistd.h>
#include <cstdlib>
#include <string>
#include <filesystem>

// Baked in at cmake configure time via -DCMAKE_INSTALL_PREFIX=...
static constexpr const char* JCE_INSTALL_CONFIG_DIR =
    "@CMAKE_INSTALL_PREFIX@/config/@INSTALL_NAMESPACE@";

// Resolve a config filename to a full path.
// Pass just the bare filename, e.g. "filter.db" — the subdir is baked in above.
inline std::string jce_config_path(const std::string& filename, std::string param_name) {
    // 1. Explicit user override
    const char* env = std::getenv("JCE_CONFIG_DIR");
    if (env) return std::string(env) + "/" + filename;

    // 2. Installed location — only use if the file actually exists there
    std::string install_path = std::string(JCE_INSTALL_CONFIG_DIR) + "/" + filename;
    if (std::filesystem::exists(install_path)) return install_path;

    // 3. Throw exception if the file is not found
    throw JException(
        "JCE_CONFIG_PATH: %s not found. Set -P%s=/path/to/%s, or set JCE_CONFIG_DIR "
        "to the directory containing all config files, or create the file at %s/%s.",
        filename.c_str(), param_name.c_str(), filename.c_str(), JCE_INSTALL_CONFIG_DIR, filename.c_str());
}

// Shared warning formatting; keep redirected logs free of terminal escapes.
inline void jce_config_warning(JLogger& logger, const std::string& message) {
    const bool color =
        (logger.destination == &std::cout && isatty(STDOUT_FILENO)) ||
        (logger.destination == &std::cerr && isatty(STDERR_FILENO));
    LOG_WARN(logger) << (color ? "\033[33m" : "") << message
        << (color ? "\033[0m" : "") << LOG_END;
}

// Resolve core + appended files after JANA parameters have been initialized.
// An explicit function file replaces only the core file; additions still apply.
inline std::vector<std::string> jce_config_files(
        const std::string& filename, const std::string& core_directory,
        const std::string& explicit_file, JLogger& logger) {
    const auto core_file = (std::filesystem::path(core_directory) / filename).string();
    const auto required_file = explicit_file.empty() ? core_file : explicit_file;
    if (!std::filesystem::is_regular_file(required_file)) {
        throw JException("JCE configuration file not found: %s", required_file.c_str());
    }
    std::vector<std::string> files {required_file};
    const char* directories = std::getenv("JCE_CONFIG_DIR");
    if (!directories) return files;
    std::istringstream list(directories);
    std::string directory;
    while (std::getline(list, directory, ':')) {
        if (directory.empty()) continue;
        if (!std::filesystem::is_directory(directory)) {
            jce_config_warning(logger,
                "Configuration directory not found: " + directory + "; skipping");
            continue;
        }
        const auto file = (std::filesystem::path(directory) / filename).string();
        if (std::filesystem::is_regular_file(file)) files.push_back(file);
    }
    return files;
}
